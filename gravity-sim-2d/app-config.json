{
	"$schema": "./app-config.schema.json",
	"window": {
		"height": 800.0,
		"width": 800.0,
		"resizable": true
	},
	"zoom": {
		"enable": true,
		"min": 0.1,
		"max": 10000.0,
		"step": 1.1,
		"initial": 10.0
	},
	"pan": {
		"enable": true
	},
	"simulation": {
		"tickRate": 60.0,
		"maxCatchUpTicks": 5
	},
	"ui": {
		"fontPath": null,
		"fontSize": 14.0,
		"showStats": true,
		"showManual": true
	},
	"generation": {
		"amount": 100,
		"area": {
			"Circle": {
				"radius": 100.0
			}
		},
		"position": {
			"Gaussian": {
				"spread": 1.9
			}
		},
		"velocity": {
			"Orbital": {
				"angular_speed": 0.5
			}
		},
		"mass": {
			"Random": {
				"min": 1.0,
				"max": 2.5
			}
		},
		"overlap": {
			"Separate": {
				"iterations": 32,
				"padding": 0.1
			}
		}
	}
}
